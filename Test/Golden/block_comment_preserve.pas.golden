unit block_comment_preserve;

interface

{
  Pipeline overview (interior columns are deliberately aligned):
    Step one      -- do the first thing
    Step twenty   -- do another thing
    Step three    -- and finally this
}

implementation

(*
   Aligned columns inside an ANSI comment:
     Alpha     = 1
     Beta      = 22
     Gamma     = 333
*)

procedure P;
begin
  {  this brace comment spans lines
     and keeps its     interior   spacing  }
  Writeln('hi');
end;

end.
