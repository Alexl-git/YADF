unit anon_proc_split;

{ Companion to anon_array_split: anonymous PROCEDURAL types (procedure / function)
  are also distinct-per-declaration and must NOT be split. A leading
  procedure/function var type also used to make the indent engine open a proc
  region and over-indent the routine's begin/end; fixed 2026-06-18 by excluding
  a colon-preceded procedure/function from opening a region. Both properties are
  pinned: the no-split property via regex in test_format_regressions.ps1, and the
  correct indentation via this file's byte-golden. }

interface

implementation

procedure AnonProcs;
var
  ProcA, ProcB: procedure of object;
  FuncA, FuncB: function: Integer  ;
  NamedA      : Integer            ;
  NamedB      : Integer            ;
begin
  ProcA:= nil;
  ProcB:= nil;
  FuncA:= nil;
  FuncB:= nil;
  NamedA:= 0;
  NamedB:= 0;
end;

end.
