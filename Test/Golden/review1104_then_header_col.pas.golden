unit review1104_then_header_col;
// REVIEW-2026-11-04-corruption L4: an over-long continuation line of an if
// condition that ends in 	hen gave its 	hen the continuation's column; the
// keyword goes on its own line at the header's column.

interface

function F(A: Integer): Integer;
function Go(Z: Integer): Integer;

implementation

function F(A: Integer): Integer;
begin
  Result:= A;
end;

function Go(Z: Integer): Integer;
begin
  Result:= 0;
  if (Z > 0)
    or (F(1) + F(2) + F(3) + F(4) + F(5) + F(6) + F(7) + F(8) + F(9) + F(10) + F(11) + F(12) + F(13) + F(14) + F(15) + F(16) + F(17) + F(18) + F(19) + F(20) + F(21) + F(22) + F(23) + F(24) + F(25) + F(26) + F(27) + F(28) + F(29) + F(30) > 0)
  then
    Result:= 1;
  while (Z > 100)
    and (F(1) + F(2) + F(3) + F(4) + F(5) + F(6) + F(7) + F(8) + F(9) + F(10) + F(11) + F(12) + F(13) + F(14) + F(15) + F(16) + F(17) + F(18) + F(19) + F(20) + F(21) + F(22) + F(23) + F(24) + F(25) + F(26) + F(27) + F(28) + F(29) + F(30) > 0)
  do
    Dec(Z);
end;

end.
