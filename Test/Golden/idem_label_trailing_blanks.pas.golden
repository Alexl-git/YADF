unit idem_label_trailing_blanks;

// Task 11 battery (TrimTrailing OFF): a block-end label was appended AFTER the
// trailing blanks of its `end;` line; the next format stripped the label with
// those blanks and re-added it after one space.

interface

function Sum(N: Integer): Integer;

implementation

function Sum(N: Integer): Integer;
begin
  Result:= 0;
  try
    Inc(Result, 1 );
    Inc(Result, 2 );
    Inc(Result, 3 );
    Inc(Result, 4 );
    Inc(Result, 5 );
    Inc(Result, 6 );
    Inc(Result, 7 );
    Inc(Result, 8 );
    Inc(Result, 9 );
    Inc(Result, 10);
    Inc(Result, 11);
    Inc(Result, 12);
    Inc(Result, 13);
    Inc(Result, 14);
    Inc(Result, 15);
    Inc(Result, 16);
  finally
    Inc(Result, N);
  end; // try
end; // function

end.
